<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexo.Client.Desktop.ViewModels"
             xmlns:v="using:Nexo.Client.Desktop.Views"
             x:Class="Nexo.Client.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Opacity" Value="0.65"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#D64545"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.card"><Setter Property="Padding" Value="28"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,10"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/><Setter Property="Padding" Value="4"/></Style>
    <Style Selector="TextBox"><Setter Property="Padding" Value="10,8"/></Style>
    <Style Selector="Border.bubble"><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="MaxWidth" Value="520"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/></Style>
    <Style Selector="Border.bubble.mine"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}"/></Style>
    <Style Selector="Border.bubble.mine :is(TextBlock)"><Setter Property="Foreground" Value="White"/></Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><v:LoginView/></DataTemplate>
    <DataTemplate DataType="vm:RegisterViewModel"><v:RegisterView/></DataTemplate>
    <DataTemplate DataType="vm:RecoveryKeyViewModel"><v:RecoveryKeyView/></DataTemplate>
    <DataTemplate DataType="vm:SecondFactorViewModel"><v:SecondFactorView/></DataTemplate>
    <DataTemplate DataType="vm:ApprovalWaitViewModel"><v:ApprovalWaitView/></DataTemplate>
    <DataTemplate DataType="vm:RecoverViewModel"><v:RecoverView/></DataTemplate>
    <DataTemplate DataType="vm:UnlockViewModel"><v:UnlockView/></DataTemplate>
    <DataTemplate DataType="vm:AcceptDocsViewModel"><v:AcceptDocsView/></DataTemplate>
    <DataTemplate DataType="vm:MainViewModel"><v:MainView/></DataTemplate>
  </Application.DataTemplates>
</Application>
