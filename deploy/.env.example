# Скопируйте в .env и заполните. Файл .env НЕ коммитить (он в .gitignore).
# Генерация секретов: openssl rand -hex 24   (пароли),   openssl rand -hex 32   (ключ WAL-G)

POSTGRES_USER=nexo
POSTGRES_PASSWORD=СМЕНИТЬ
POSTGRES_DB=nexo
PG_SHARED_BUFFERS=256MB

REDIS_PASSWORD=СМЕНИТЬ

MINIO_ROOT_USER=nexo-minio
MINIO_ROOT_PASSWORD=СМЕНИТЬ_МИНИМУМ_12_СИМВОЛОВ

# ---- Резервные копии (WAL-G): полная копия раз в сутки + непрерывный WAL (RPO до 5 минут)
# Для первых проверок – локальный MinIO. В боевой среде – ВНЕШНЕЕ S3 (другой провайдер/сервер!).
WALG_S3_PREFIX=s3://nexo-backups/pg
WALG_S3_ENDPOINT=http://minio:9000
WALG_S3_ACCESS_KEY=nexo-minio
WALG_S3_SECRET_KEY=СМЕНИТЬ_КАК_MINIO_ROOT_PASSWORD
WALG_S3_REGION=us-east-1
# 64 hex-символа (32 байта). ХРАНИТЕ КОПИЮ ВНЕ СЕРВЕРА: без неё копии не расшифровать.
WALG_LIBSODIUM_KEY=СМЕНИТЬ_64_HEX
BACKUP_HOUR_UTC=3
BACKUP_RETAIN_FULL=30

# ---- Логическая копия (pg_dump + age). Нужен ТОЛЬКО открытый ключ.
# Создать пару ключей на СВОЁМ компьютере:  age-keygen -o nexo-age.key
# Строку "Public key: age1..." вставить сюда, файл nexo-age.key хранить вне сервера.
AGE_RECIPIENT=age1СМЕНИТЬ
LOGICAL_RETAIN_DAYS=30

# ---- Выгрузка логических копий во внешнее S3 (включить в боевой среде)
OFFSITE_ENABLED=false
OFFSITE_PROVIDER=Other
OFFSITE_ENDPOINT=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
OFFSITE_PATH=nexo-offsite/logical

# ---- Сервер приложения
# Домен сервера (для локальной проверки оставьте localhost)
NEXO_DOMAIN=localhost
# Ключ шифрования секретов в БД (32 байта в base64):  openssl rand -base64 32
# ХРАНИТЕ КОПИЮ ВНЕ СЕРВЕРА: без него зашифрованные секреты в БД не прочесть.
NEXO_KEK_BASE64=СМЕНИТЬ
# Секрет для ложных параметров KDF (32 байта в base64):  openssl rand -base64 32
NEXO_FAKE_KDF_SECRET_BASE64=СМЕНИТЬ
