digraph G { rankdir=LR; splines=true; nodesep=0.35; ranksep=1.8; pad=0.3; bgcolor=white; compound=true;
 node [fontname="Times New Roman", fontsize=14];
 edge [arrowhead=none, color="#444444"];
 U [shape=box, style=filled, fillcolor="#D9D9D9", label="Пользователь"];
 M [shape=box, style=filled, fillcolor="#D9D9D9", label="Модератор"];
 A [shape=box, style=filled, fillcolor="#D9D9D9", label="Администратор"];
 O [shape=box, style=filled, fillcolor="#D9D9D9", label="Уполномоченный\nорган (через\nадминистратора)"];
 subgraph cluster_sys { label="Система NEXO"; labeljust=l; fontname="Times New Roman"; fontsize=16; style=rounded; color="#555555";
  node [shape=ellipse, style=filled, fillcolor=white];
  u1 [label="Зарегистрироваться и войти"]; u2 [label="Восстановить доступ по ключу"]; u3 [label="Управлять устройствами\nи двухфакторной защитой"];
  u4 [label="Вести личные чаты"]; u5 [label="Создавать группы и каналы"]; u6 [label="Отправлять сообщения,\nфайлы, кружки, голосовые"];
  u7 [label="Работать офлайн"]; u8 [label="Вести секретные чаты (E2EE)"]; u9 [label="Звонить: аудио, видео,\nдемонстрация экрана"];
  u10 [label="Настраивать оформление\nи горячие клавиши"]; u11 [label="Организовывать чаты\nпапками"]; u12 [label="Устанавливать статус"];
  u13 [label="Задавать таймер\nудаления сообщений"]; u14 [label="Управлять приватностью\nи блокировками"]; u15 [label="Подавать жалобы"];
  m1 [label="Рассматривать жалобы"]; m2 [label="Применять меры"]; m3 [label="Вести словарь фильтра"];
  a1 [label="Обрабатывать обращения\nорганов"]; a2 [label="Просматривать журнал аудита"]; a3 [label="Управлять ролями"];
 }
 U -> {u1 u2 u3 u4 u5 u6 u7 u8 u9 u10 u11 u12 u13 u14 u15};
 M -> {m1 m2 m3};
 A -> {a1 a2 a3 m1};
 O -> a1;
}
