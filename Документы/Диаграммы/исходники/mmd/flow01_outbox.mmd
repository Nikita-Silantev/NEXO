flowchart TD
    A([Начало: пользователь отправил сообщение]) --> B[Создать client_msg_id UUIDv7]
    B --> C[Сохранить в локальную БД, статус Pending]
    C --> D{Есть соединение и действует токен?}
    D -- Нет --> E[Ждать: экспоненциальная пауза 1, 2, 4 … 60 с]
    E --> D
    D -- Да --> F[SendMessage]
    F --> G{Ответ получен?}
    G -- Нет, обрыв --> E
    G -- Да --> H{Ошибка?}
    H -- TOKEN_EXPIRED --> I[RefreshToken] --> D
    H -- Постоянная ошибка --> J[Статус Failed, показать причину]
    H -- Нет --> K[Заменить запись серверной, статус Sent]
    J --> Z([Конец])
    K --> Z
